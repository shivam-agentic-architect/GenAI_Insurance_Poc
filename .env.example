# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key"

# APP_URL: The URL where this app is hosted.
APP_URL="your_app_url"

# OPENAI_API_KEY: Required for GPT RAG functionality.
OPENAI_API_KEY="your_openai_api_key"

# ADMIN_USERNAME: The username for logging in to the admin interface (backend only).
ADMIN_USERNAME="your_admin_username"

# ADMIN_PASSWORD: The password for logging in to the admin interface (backend only).
ADMIN_PASSWORD="your_admin_password"
